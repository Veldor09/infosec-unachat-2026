# Copie este archivo como .env y complete los valores. .env esta en .gitignore: no lo suba.

# --- Grafana Cloud (OpenTelemetry, OTLP directo al gateway) ---
# Grafana Cloud > su stack > Connections > OpenTelemetry (OTLP). Solo en local; Render no lo usa.
# Endpoint: termina en /otlp (no en /otlp/v1/traces).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Basic%20<base64 de "instanceId:token glc_...">, sin comillas y con %20
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=una-chat
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# --- Sentry ---
# Sentry > Settings > Projects > (proyecto) > Client Keys (DSN)
SENTRY_DSN=

# --- Pruebas ---
# true habilita el comando /fallo (error controlado). Dejarlo vacio para retirarlo.
CHAT_FALLO_CONTROLADO=
