# Copie este archivo como .env y complete los valores. .env esta en .gitignore: no lo suba.

# --- Inicio de sesion con Auth0 y Supabase Vault (laboratorio 8) ---
# Con AUTH0_DOMAIN y AUTH0_CLIENT_ID vacios el chat queda abierto, que es como corren las pruebas.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
APP_BASE_URL=http://localhost:3000

# URI de Postgres del rol una_chat_backend. TLS obligatorio.
# Host directo (IPv6): postgresql://una_chat_backend:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=verify-full
# Session pooler IPv4: postgresql://una_chat_backend.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
VAULT_DATABASE_URL=

# No defina AUTH0_CLIENT_SECRET. El backend lee
# una_chat_auth0_client_secret desde Supabase Vault al arrancar.

# --- Grafana Cloud (OpenTelemetry, OTLP directo al gateway) ---
# Grafana Cloud > su stack > Connections > OpenTelemetry (OTLP). Solo en local; Render no lo usa.
# Endpoint: termina en /otlp (no en /otlp/v1/traces).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Basic%20<base64 de "instanceId:token glc_...">, sin comillas y con %20
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=una-chat
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# --- Sentry ---
# Sentry > Settings > Projects > (proyecto) > Client Keys (DSN)
SENTRY_DSN=

# --- Pruebas ---
# true habilita el comando /fallo (error controlado). Dejarlo vacio para retirarlo.
CHAT_FALLO_CONTROLADO=
